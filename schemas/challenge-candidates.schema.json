{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed supplied challenge-candidates",
  "description": "Descriptive completed-input structure only, not approval, actual human authorship, independence, scientific sufficiency or readiness. Existing Python validators remain authoritative for nonblank text, real calendar dates, duplicate row IDs, provenance length/control characters, source/context references and exact basis/gate/target bindings. Incomplete templates are not valid completed documents. Schema success is not authorization or exact replay. No research or review is generated.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alternative_explanation": {
            "type": "string",
            "minLength": 1
          },
          "challenge_id": {
            "type": "string",
            "minLength": 1
          },
          "challenged_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "challenger": {
            "type": "string",
            "minLength": 1
          },
          "independence_declaration": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "statement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "missing_discriminating_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          },
          "citation_integrity_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "finding": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "evidence_id",
                "finding"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "conclusion_width": {
            "type": "string",
            "enum": [
              "WITHIN_CITED_EVIDENCE",
              "BROADER_THAN_CITED_EVIDENCE",
              "NOT_ASSESSED"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SURVIVES",
              "MATERIAL_GAP",
              "UNRESOLVED"
            ]
          },
          "reopening": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "work_package_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "work_package_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "amendment_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "amendment_note"
                ],
                "additionalProperties": false
              }
            ]
          },
          "basis_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "HUMAN_AUTHORED"
                  },
                  "package_sha256": {
                    "type": "null"
                  },
                  "consultation_record_sha256": {
                    "type": "null"
                  },
                  "declared_provenance": {
                    "type": "null"
                  }
                },
                "required": [
                  "kind",
                  "package_sha256",
                  "consultation_record_sha256",
                  "declared_provenance"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "INTERPRETIVE_SIMULATION"
                  },
                  "package_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "consultation_record_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "declared_provenance": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "execution_location": {
                            "type": "string",
                            "enum": [
                              "local",
                              "remote",
                              "unknown"
                            ]
                          },
                          "model_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "operator_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "provider_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "run_id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "execution_location",
                          "model_id",
                          "operator_id",
                          "provider_id",
                          "run_id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "package_sha256",
                  "consultation_record_sha256",
                  "declared_provenance"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "alternative_explanation",
          "basis_sha256",
          "challenge_id",
          "challenged_at",
          "challenger",
          "citation_integrity_findings",
          "conclusion_width",
          "independence_declaration",
          "limitations",
          "missing_discriminating_evidence",
          "outcome",
          "reopening",
          "statement_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "challenges"
  ],
  "additionalProperties": false
}

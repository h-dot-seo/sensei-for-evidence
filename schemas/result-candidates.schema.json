{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed manual result candidates",
  "description": "Descriptive completed input shape only. Existing result_intake Python validation remains authoritative for nonblank text, calendar dates, duplicate evidence/source IDs, actual protocol/source bindings and exact target hashes. Does not generate results or review, read sources, authenticate people or establish scientific correctness. A shape match is not approval.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "study_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "intervention": {
                "type": "string",
                "minLength": 1
              },
              "comparator": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              },
              "mechanism_basis": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "association",
                  "intervention",
                  "unknown"
                ]
              }
            },
            "required": [
              "evidence_id",
              "record_id",
              "study_id",
              "locator",
              "model",
              "intervention",
              "comparator",
              "endpoint",
              "result",
              "limitations",
              "mechanism_basis"
            ],
            "additionalProperties": false
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "extraction_locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "extraction_locator"
              ],
              "additionalProperties": false
            }
          },
          "extracted_by": {
            "type": "string",
            "minLength": 1
          },
          "extracted_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "extraction_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "report_id",
          "evidence",
          "source_references",
          "extracted_by",
          "extracted_at",
          "extraction_note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "candidates"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recommended ledger-free starting protocol",
  "description": "Stricter recommended shape than general run(). Nonblank text, unique search_id and fresh-base checks are engine-only. No complete protocol schema. Python workflow validators remain authoritative; shape match is not approval, acceptance or scientific validity.",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "inclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "search_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "search_id",
          "source",
          "query",
          "window"
        ],
        "additionalProperties": false
      }
    },
    "searches": {
      "type": "array",
      "maxItems": 0
    },
    "screening": {
      "type": "array",
      "maxItems": 0
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "gaps": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "question",
    "version",
    "inclusion_criteria",
    "exclusion_criteria",
    "search_plan",
    "searches",
    "screening",
    "evidence",
    "gaps"
  ],
  "additionalProperties": false
}

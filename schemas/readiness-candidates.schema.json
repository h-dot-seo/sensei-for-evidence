{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed supplied readiness-candidates",
  "description": "Descriptive completed-input structure only, not approval, actual human authorship, independence, scientific sufficiency or readiness. Existing Python validators remain authoritative for nonblank text, real calendar dates, duplicate row IDs, provenance length/control characters, source/context references and exact basis/gate/target bindings. Incomplete templates are not valid completed documents. Schema success is not authorization or exact replay. No research or review is generated.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "readiness_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "assessed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "assessor": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "scope_statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sufficiency": {
            "type": "string",
            "enum": [
              "SUFFICIENT",
              "INSUFFICIENT",
              "UNASSESSED"
            ]
          },
          "conclusion_readiness": {
            "type": "string",
            "enum": [
              "READY",
              "NOT_READY"
            ]
          },
          "gates_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reopening": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "work_package_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "work_package_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "amendment_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "amendment_note"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "assertion_id",
          "assessed_at",
          "assessor",
          "limitations",
          "rationale",
          "scope_statement",
          "evidence_sufficiency",
          "conclusion_readiness",
          "gates_sha256",
          "reopening"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "readiness_assertions"
  ],
  "additionalProperties": false
}
